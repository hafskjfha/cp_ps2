{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Python with Input",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "if /I \"${fileExtname}\"==\".py\" (python \"${file}\" < \"${fileDirname}\\input.in\") else if /I \"${fileExtname}\"==\".cpp\" (C:\\msys64\\ucrt64\\bin\\g++.exe \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}.exe\")"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}